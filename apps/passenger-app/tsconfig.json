{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] }
  },
  "include": ["**/*.ts", "**/*.tsx", "../../packages/shared/src/**/*.ts", "../../packages/mobile-ui/src/**/*.ts", "../../packages/mobile-ui/src/**/*.tsx"],
  "exclude": ["node_modules", "android", "ios", "dist", ".expo"]
}
