{
  "name": "traveo",
  "version": "2.0.0",
  "private": true,
  "description": "Traveo \u2014 college-verified, passenger-first shared rides (monorepo)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run passenger:web",
    "backend": "cd backend && uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload",
    "backend:test": "cd backend && python -m pytest -q",
    "passenger": "npm run start --workspace apps/passenger-app",
    "passenger:android": "npm run android --workspace apps/passenger-app",
    "passenger:web": "npm run web --workspace apps/passenger-app",
    "passenger-tester:web": "npm run web --workspace apps/passenger-tester",
    "driver": "npm run start --workspace apps/driver-app",
    "driver:android": "npm run android --workspace apps/driver-app",
    "driver:web": "npm run web --workspace apps/driver-app",
    "admin": "npm run dev --workspace apps/admin-panel",
    "admin:build": "npm run build --workspace apps/admin-panel",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "@types/react": "~19.1.0"
  }
}
